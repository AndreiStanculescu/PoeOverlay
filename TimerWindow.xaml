<Window x:Class="MyPoeOverlay.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="PoeOverlay.ico"
        Title="Overlay Timer"
        Width="320"
        Height="220"
        MinWidth="280"
        MinHeight="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="TimerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FF292929"/>
            <Setter Property="Foreground" Value="#FFFFCC00"/>
            <Setter Property="BorderBrush" Value="#FF665522"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FFFFCC00"/>
            <Setter Property="Background" Value="#FF292929"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="#FF3A3524"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="TimerWindowBorder"
            Background="#F0151518"
            BorderBrush="#FF494949"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TimerWindowTitleText"
                           Text="OVERLAY TIMER"
                           Foreground="#FFFFCC00"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="WindowLockButton"
                            Content="Lock"
                            Width="54"
                            Height="28"
                            Margin="0,0,6,0"
                            Background="#FF292929"
                            Foreground="#FFFFCC00"
                            BorderBrush="#FF665522"
                            Click="WindowLockButton_Click"
                            ToolTip="Lock window position and size"
                            Cursor="Hand"/>
                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#FFAAAAAA"
                            BorderThickness="0"
                            FontSize="16"
                            Click="HideButton_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <ComboBox x:Name="ActComboBox"
                      Grid.Row="1"
                      Height="30"
                      Margin="0,0,0,8"
                      Padding="6,3"
                      Background="#FF292929"
                      Foreground="#FFFFCC00"
                      FontWeight="Bold"
                      HorizontalContentAlignment="Center"
                      BorderBrush="#FF555555"
                      IsTextSearchEnabled="False"
                      SelectionChanged="ActComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#FFFFCC00"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.Template>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 5 5 L 10 0"
                                                  Stroke="#FFFFE080"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Slide">
                                <Border Background="#FF292929"
                                        BorderBrush="#FF555555"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer MaxHeight="300"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
            </ComboBox>

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TimerActText"
                           Text="Waiting for Act 1"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="TimerText"
                         Text="00:00:00"
                         Foreground="#FFF2C75C"
                         FontSize="32"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         Cursor="IBeam"
                         ToolTip="Click to edit time. Press Enter to apply or Esc to cancel."
                         PreviewMouseLeftButtonDown="TimerText_PreviewMouseLeftButtonDown"
                         KeyDown="TimerText_KeyDown"
                         LostKeyboardFocus="TimerText_LostKeyboardFocus"
                         Margin="0,3,0,0"/>
            </StackPanel>

            <TextBlock x:Name="TimerStatusText"
                       Grid.Row="3"
                       Text="WAITING"
                       Foreground="#FFB0B4BE"
                       FontSize="9"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <Grid Grid.Row="4"
                  Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton"
                        Content="Start"
                        Grid.Column="0"
                        Margin="2"
                        Click="StartButton_Click"
                        Style="{StaticResource TimerButtonStyle}"/>
                <Button x:Name="PauseButton"
                        Content="Pause"
                        Grid.Column="1"
                        Margin="2"
                        Click="PauseButton_Click"
                        Style="{StaticResource TimerButtonStyle}"/>
                <Button x:Name="StopButton"
                        Content="Stop"
                        Grid.Column="2"
                        Margin="2"
                        Click="StopButton_Click"
                        Style="{StaticResource TimerButtonStyle}"/>
                <Thumb x:Name="ResizeThumb"
                       Grid.Column="3"
                       Width="20"
                       Height="28"
                       Cursor="SizeNWSE"
                       Background="Transparent"
                       DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent">
                                <TextBlock Text="◢"
                                           Foreground="#FFAAAAAA"
                                           FontSize="15"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</Window>
