<Window x:Class="MyPoeOverlay.ActHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="PoeOverlay.ico"
        Title="Act time records"
        Width="480"
        Height="360"
        MinWidth="400"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#F0151518"
            BorderBrush="#FF494949"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Margin="0,0,0,8"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           Foreground="#FFFFCC00"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#FFAAAAAA"
                        BorderThickness="0"
                        FontSize="16"
                        Click="CloseButton_Click"
                        Cursor="Hand"/>
            </Grid>
            <Grid Grid.Row="1"
                  Margin="0,0,20,20">
                <DataGrid x:Name="RecordsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#FF393939"
                          Background="#FF202020"
                          Foreground="White"
                          BorderThickness="0"
                          RowBackground="#FF252525"
                          AlternatingRowBackground="#FF2D2D2D"
                          ColumnHeaderHeight="32"
                          RowHeight="34"
                          FontSize="11"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF303030"/>
                            <Setter Property="Foreground" Value="#FFFFCC00"/>
                            <Setter Property="BorderBrush" Value="#FF454545"/>
                            <Setter Property="Padding" Value="5,4"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="CenteredRecordTextStyle"
                               TargetType="{x:Type TextBlock}">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Run started"
                                            Binding="{Binding StartedAt}"
                                            Width="*"
                                            MinWidth="120"
                                            ElementStyle="{StaticResource CenteredRecordTextStyle}"/>
                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Duration}"
                                            Width="90"
                                            MinWidth="80"
                                            ElementStyle="{StaticResource CenteredRecordTextStyle}"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="90"
                                            MinWidth="80"
                                            ElementStyle="{StaticResource CenteredRecordTextStyle}"/>
                        <DataGridTemplateColumn Header="Delete"
                                                Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×"
                                            Tag="{Binding SessionId}"
                                            Click="DeleteRecordButton_Click"
                                            Padding="6,1"
                                            FontSize="14"
                                            Background="#FF3A2929"
                                            Foreground="#FFFFB0B0"
                                            BorderBrush="#FF704545"
                                            BorderThickness="1"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText"
                           Text="No saved times for this act."
                           Foreground="#FFAAAAAA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
            <Button Grid.Row="2"
                    Content="Close"
                    Width="80"
                    Height="30"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Background="#FF292929"
                    Foreground="White"
                    BorderBrush="#FF555555"
                    Click="CloseButton_Click"/>
            <Thumb Grid.Row="1"
                   Width="24"
                   Height="24"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   Background="Transparent"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <TextBlock Text="◢"
                                       Foreground="#FFAAAAAA"
                                       FontSize="18"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
