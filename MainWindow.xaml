<Window x:Class="MyPoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Leveling Overlay"
        Width="390"
        Height="520"
        MinWidth="320"
        MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize">

    <Border Background="#F0151518"
            BorderBrush="#FF494949"
            BorderThickness="1"
            CornerRadius="12"
            Padding="15">

        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <TextBlock Text="POE LEVELING"
                           Foreground="#FFFFCC00"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="⚙"
                            Width="30"
                            Height="28"
                            Margin="0,0,6,0"
                            Background="#FF292929"
                            Foreground="White"
                            BorderBrush="#FF555555"
                            FontSize="16"
                            Click="SettingsButton_Click"
                            Cursor="Hand"/>

                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#FFAAAAAA"
                            BorderThickness="0"
                            FontSize="16"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

        
<!-- Settings panel -->
<Border x:Name="SettingsPanel"
        Grid.Row="1"
        Visibility="Collapsed"
        Background="#FF202020"
        BorderBrush="#FF505050"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8"
        Margin="0,8,0,8">

    <TabControl Background="#FF202020"
                Foreground="White"
                BorderThickness="0">

        <!-- APPEARANCE TAB -->
        <TabItem Header="Appearance"
                 Padding="10,6">

            <StackPanel Margin="6,12,6,8">

                <TextBlock Text="OVERLAY APPEARANCE"
                           Foreground="#FFFFCC00"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Opacity"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="OpacityValueText"
                               Text="100%"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="OpacitySlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="35"
                            Maximum="100"
                            Value="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Text size"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="FontSizeValueText"
                               Text="16"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="FontSizeSlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="10"
                            Maximum="24"
                            Value="16"
                            TickFrequency="1"
                            IsSnapToTickEnabled="False"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                </Grid>

            </StackPanel>
        </TabItem>

                <!-- ACT TIMES TAB -->
                <TabItem Header="Act Times"
                        Padding="10,6">

                    <Grid Margin="2,10,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ActTimesSummaryText"
                                Grid.Row="0"
                                Text="Your leveling history"
                                Foreground="#FFAAAAAA"
                                FontSize="11"
                                Margin="4,0,4,10"
                                TextWrapping="Wrap"/>

                        <DataGrid x:Name="ActTimesGrid"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeRows="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal"
                                HorizontalGridLinesBrush="#FF393939"
                                Background="#FF202020"
                                Foreground="White"
                                BorderThickness="0"
                                RowBackground="#FF252525"
                                AlternatingRowBackground="#FF2D2D2D"
                                ColumnHeaderHeight="32"
                                RowHeight="34"
                                FontSize="11"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="#FF303030"/>
                                    <Setter Property="Foreground"
                                            Value="#FFFFCC00"/>
                                    <Setter Property="BorderBrush"
                                            Value="#FF454545"/>
                                    <Setter Property="Padding"
                                            Value="5,4"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="Padding"
                                            Value="5,2"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                </Style>


                                <Style TargetType="{x:Type DataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewPersonalBest}"
                                                    Value="True">
                                            <Setter Property="Background"
                                                    Value="#FF24452F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>


                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Act"
                                                        Width="*"
                                                        MinWidth="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActName}"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Status}"
                                                        Foreground="{Binding StatusBrush}"
                                                        FontSize="9"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTextColumn Header="This run"
                                                    Binding="{Binding CurrentRunTime}"
                                                    Width="88"
                                                    MinWidth="75"/>

                                <DataGridTextColumn Header="Best ever"
                                                    Binding="{Binding BestTime}"
                                                    Width="82"
                                                    MinWidth="72"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>


            <!-- Progress -->
            <TextBlock x:Name="ProgressText"
                       Grid.Row="2"
                       Text="Loading route..."
                       Foreground="#FFAAAAAA"
                       FontSize="12"
                       Margin="0,8,0,12"/>


                       <Border Grid.Row="3"
                        Background="#252831"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,6,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TimerActText"
                                    Text="Waiting for Act 1"
                                    Foreground="White"
                                    FontSize="13"
                                    FontWeight="SemiBold"/>

                            <TextBlock x:Name="TimerStatusText"
                                    Text="WAITING"
                                    Foreground="#B0B4BE"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBlock x:Name="TimerText"
                                Text="00:00:00"
                                Foreground="#F2C75C"
                                FontSize="28"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,8"/>

                        <UniformGrid Columns="3">
                            <Button Content="Start"
                                    Click="StartTimerButton_Click"
                                    Margin="2"/>

                            <Button Content="Pause"
                                    Click="PauseTimerButton_Click"
                                    Margin="2"/>

                            <Button Content="Stop"
                                    Click="StopTimerButton_Click"
                                    Margin="2"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            <!-- Act selector and objectives -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="ActComboBox"
                          Grid.Row="0"
                          Height="34"
                          Margin="0,0,0,12"
                          Padding="8,4"
                          FontSize="14"
                          Background="#FF292929"
                          Foreground="#FFFFCC00"
                          BorderBrush="#FF555555"
                          SelectionChanged="ActComboBox_SelectionChanged"/>

                <TextBlock Grid.Row="1"
                           Text="ACT OBJECTIVES"
                           Foreground="#FFFFCC00"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ObjectiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Marker}"
                                               Foreground="{Binding MarkerBrush}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="1"
                                                Text="{Binding Description}"
                                                Foreground="{Binding TextBrush}"
                                                FontSize="{Binding FontSize}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Client log status -->
            <TextBlock x:Name="ClientLogStatus"
                       Grid.Row="5"
                       Text="Waiting for Client.txt..."
                       Foreground="#FFAAAAAA"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8"/>

            <!-- Manual navigation -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Stretch">

                <Button Content="← Previous"
                        Height="34"
                        Width="165"
                        Margin="0,0,10,0"
                        Background="#FF292929"
                        Foreground="White"
                        BorderBrush="#FF555555"
                        Click="PreviousStepButton_Click"
                        Cursor="Hand"/>

                <Button Content="Next →"
                        Height="34"
                        Width="165"
                        Background="#FF3A3524"
                        Foreground="#FFFFCC00"
                        BorderBrush="#FF665522"
                        Click="NextStepButton_Click"
                        Cursor="Hand"/>
            </StackPanel>
            <!-- Resize handle -->
            <Thumb x:Name="ResizeThumb"
                    Grid.Row="0"
                    Grid.RowSpan="7"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="18"
                   Height="18"
                   Cursor="SizeNWSE"
                   Background="Transparent"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <TextBlock Text="◢"
                                       Foreground="#FF888888"
                                       FontSize="15"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
