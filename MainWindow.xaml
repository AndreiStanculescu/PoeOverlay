<Window x:Class="MyPoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Leveling Overlay"
        Width="350"
        Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#DD111111"
            CornerRadius="12"
            Padding="15">

        <Grid>

            <!-- Buton Close -->
            <Button Content="✕"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Foreground="#FFAAAAAA"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="CloseButton_Click"
                    Cursor="Hand"/>

            <StackPanel Margin="0,0,35,0">

                <TextBlock Text="POE LEVELING"
                           Foreground="#FFFFCC00"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock Text="ACT 1"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,8,0,0"/>

                <TextBlock Text="► Enter The Flooded Depths"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,12,0,0"/>

            </StackPanel>

        </Grid>

    </Border>
</Window>