<Window x:Class="MyPoeOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="PoeOverlay.ico"
        Title="Main Overlay"
        Width="390"
        Height="520"
        MinWidth="320"
        MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResize">

    <Border Background="#F0151518"
            BorderBrush="#FF494949"
            BorderThickness="1"
            CornerRadius="12"
            Padding="15">

        <Grid>
            <Grid.Resources>
                <Style TargetType="{x:Type Slider}">
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="Foreground" Value="#FFF2C75C"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Slider}">
                                <Grid>
                                    <Track x:Name="PART_Track"
                                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge"
                                                          Focusable="False"
                                                          IsTabStop="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Height="4"
                                                                Background="#FFF2C75C"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="14"
                                                   Height="14"
                                                   Background="#FFFFCC00">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="#FFFFE080"
                                                                BorderThickness="1"
                                                                CornerRadius="7"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge"
                                                          Focusable="False"
                                                          IsTabStop="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Height="4"
                                                                Background="#FF494949"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="3"/>
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Background" Value="#FF202020"/>
                    <Setter Property="Foreground" Value="#FF806B2D"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Orientation="{TemplateBinding Orientation}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.Thumb>
                                        <Thumb Background="#FF806B2D">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="2"
                                                            Margin="0.5"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="3"/>
                                        <Setter Property="Width" Value="Auto"/>
                                    </Trigger>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="3"/>
                                        <Setter Property="Height" Value="Auto"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="MAIN OVERLAY"
                               Foreground="#FFFFCC00"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="WindowLockButton"
                            Content="Lock"
                            Width="54"
                            Height="28"
                            Margin="8,0,0,0"
                            Background="#FF292929"
                            Foreground="#FFFFCC00"
                            BorderBrush="#FF665522"
                            Click="WindowLockButton_Click"
                            ToolTip="Lock window position and size"
                            Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Timer"
                            Height="28"
                            Margin="0,0,6,0"
                            Padding="8,0"
                            Background="#FF292929"
                            Foreground="#FFFFCC00"
                            BorderBrush="#FF665522"
                            Click="ShowTimerWindowButton_Click"
                            Cursor="Hand"/>

                    <Button Content="⚙"
                            Width="30"
                            Height="28"
                            Margin="0,0,6,0"
                            Background="#FF292929"
                            Foreground="White"
                            BorderBrush="#FF555555"
                            FontSize="16"
                            Click="SettingsButton_Click"
                            Cursor="Hand"/>

                    <Button Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#FFAAAAAA"
                            BorderThickness="0"
                            FontSize="16"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

        
<!-- Settings panel -->
<Border x:Name="SettingsPanel"
        Grid.Row="1"
        Visibility="Collapsed"
        Background="#FF202020"
        BorderBrush="#FF505050"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8"
        Margin="0,8,0,8">

    <TabControl Background="#FF202020"
                Foreground="White"
                BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="{x:Type TabControl}">
                <Grid KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,4,0"
                                IsItemsHost="True"
                                KeyboardNavigation.TabIndex="1">
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="10">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabControl.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="#FFFFCC00"/>
                <Setter Property="Background" Value="#FF292929"/>
                <Setter Property="BorderBrush" Value="#FF555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Margin="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder"
                                            Property="Background"
                                            Value="#FF3A3524"/>
                                    <Setter TargetName="TabBorder"
                                            Property="BorderBrush"
                                            Value="#FF665522"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder"
                                            Property="Background"
                                            Value="#FF353023"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <!-- APPEARANCE TAB -->
        <TabItem Header="Appearance"
                 Padding="10,6">

            <StackPanel Margin="6,12,6,8">

                <TextBlock Text="CLICK-THROUGH TOGGLE"
                           Foreground="#FFFFCC00"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Press a shortcut to set the global toggle hotkey."
                           Foreground="#FFAAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ClickThroughHotkeyTextBox"
                         Text="Ctrl+Shift+O"
                         IsReadOnly="True"
                         Height="30"
                         Padding="8,5"
                         Background="#FF292929"
                         Foreground="#FFFFCC00"
                         BorderBrush="#FF665522"
                         PreviewKeyDown="ClickThroughHotkeyTextBox_PreviewKeyDown"
                         GotKeyboardFocus="ClickThroughHotkeyTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="ClickThroughHotkeyTextBox_LostKeyboardFocus"
                         ToolTip="Focus this field and press a shortcut with Ctrl, Alt, Shift, or Windows"/>
                <TextBlock x:Name="ClickThroughHotkeyStatusText"
                           Text="Overlay is interactive"
                           Foreground="#FFAAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"/>

                <TextBlock Text="MAIN OVERLAY"
                           Foreground="#FFFFCC00"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Opacity"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="OpacityValueText"
                               Text="100%"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="OpacitySlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="35"
                            Maximum="100"
                            Value="100"
                            TickFrequency="5"
                            SmallChange="1"
                            LargeChange="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Text size (px)"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="FontSizeValueText"
                               Text="16"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="FontSizeSlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="10"
                            Maximum="24"
                            Value="16"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                </Grid>

                <TextBlock Text="OVERLAY TIMER"
                           Foreground="#FFFFCC00"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Opacity"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TimerOpacityValueText"
                               Text="100%"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="TimerOpacitySlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="35"
                            Maximum="100"
                            Value="100"
                            TickFrequency="5"
                            SmallChange="1"
                            LargeChange="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="TimerOpacitySlider_ValueChanged"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Text size (px)"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="White"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TimerFontSizeValueText"
                               Text="16"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#FFFFCC00"
                               Margin="8,0,0,6"/>

                    <Slider x:Name="TimerFontSizeSlider"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="10"
                            Maximum="24"
                            Value="16"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="TimerFontSizeSlider_ValueChanged"/>
                </Grid>

            </StackPanel>
        </TabItem>

                <!-- ACT TIMES TAB -->
                <TabItem Header="Act Times"
                        Padding="10,6">

                    <Grid Margin="8,6,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ActTimesSummaryText"
                                Grid.Row="0"
                                Text="Your leveling history"
                                Foreground="#FFAAAAAA"
                                FontSize="11"
                                TextAlignment="Center"
                                Margin="4,0,4,10"
                                TextWrapping="Wrap"/>

                        <DataGrid x:Name="ActTimesGrid"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeRows="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal"
                                HorizontalGridLinesBrush="#FF393939"
                                Background="#FF202020"
                                Foreground="White"
                                BorderThickness="0"
                                RowBackground="#FF252525"
                                AlternatingRowBackground="#FF2D2D2D"
                                ColumnHeaderHeight="32"
                                RowHeight="34"
                                FontSize="11"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="#FF303030"/>
                                    <Setter Property="Foreground"
                                            Value="#FFFFCC00"/>
                                    <Setter Property="BorderBrush"
                                            Value="#FF454545"/>
                                    <Setter Property="Padding"
                                            Value="5,4"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="Padding"
                                            Value="5,2"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>
                                </Style>


                                <Style TargetType="{x:Type DataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewPersonalBest}"
                                                    Value="True">
                                            <Setter Property="Background"
                                                    Value="#FF24452F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>


                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Act"
                                                        Width="*"
                                                        MinWidth="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ActName}"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"
                                                        TextAlignment="Center"/>

                                                <TextBlock Text="{Binding Status}"
                                                        Foreground="{Binding StatusBrush}"
                                                        FontSize="9"
                                                        TextAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTextColumn Header="This run"
                                                    Binding="{Binding CurrentRunTime}"
                                                    Width="88"
                                                    MinWidth="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Best ever"
                                                    Binding="{Binding BestTime}"
                                                    Width="82"
                                                    MinWidth="72">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Records"
                                                        Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="View"
                                                    Tag="{Binding ActName}"
                                                    Click="ShowActHistoryButton_Click"
                                                    Padding="4,2"
                                                    FontSize="9"
                                                    Background="#FF292929"
                                                    Foreground="#FFFFCC00"
                                                    BorderBrush="#FF665522"
                                                    BorderThickness="1"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Clear"
                                                        Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Clear"
                                                    Tag="{Binding ActName}"
                                                    Click="ClearActTimesButton_Click"
                                                    Padding="4,2"
                                                    FontSize="9"
                                                    Background="#FF3A2929"
                                                    Foreground="#FFFFB0B0"
                                                    BorderBrush="#FF704545"
                                                    BorderThickness="1"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

            <!-- Act selector and objectives -->
            <Grid Grid.Row="2"
                  Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="ActComboBox"
                          Grid.Row="0"
                          SelectedValuePath="ActName"
                          Height="34"
                          Margin="0,0,0,8"
                          Padding="8,4"
                          FontSize="14"
                          FontWeight="Bold"
                          Background="#FF292929"
                          Foreground="#FFFFCC00"
                          BorderBrush="#FF555555"
                          HorizontalContentAlignment="Center"
                          SelectionChanged="ActComboBox_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#FFFFCC00"/>
                            <Setter Property="Background" Value="#FF292929"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Border x:Name="ItemBackground"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter
                                                              Margin="0"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBackground"
                                                        Property="Background"
                                                        Value="#FF3A3524"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#FFFFCC00"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Template>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"/>

                                <ToggleButton x:Name="DropDownToggle"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <Path Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#FFFFE080"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,13,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Margin="8,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"/>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Slide">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5"
                                            Padding="0">
                                        <ScrollViewer MaxHeight="300"
                                                      CanContentScroll="True"
                                                      Padding="0">
                                            <ItemsPresenter Margin="0"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                </ComboBox>

                <TextBlock x:Name="ProgressText"
                           Grid.Row="1"
                           Text="Loading route..."
                           Foreground="#FFAAAAAA"
                           FontSize="11"
                           Margin="0,0,0,5"/>

                <TextBlock Grid.Row="2"
                           Text="ACT OBJECTIVES"
                           Foreground="#FFFFCC00"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <ScrollViewer x:Name="ObjectiveScrollViewer"
                              Grid.Row="3"
                              Padding="0,0,6,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ObjectiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="9"
                                        Background="#FF222225"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding Marker}"
                                                       Foreground="{Binding MarkerBrush}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,9,0"/>
                                            <StackPanel>
                                                <TextBlock Text="NEXT AREA"
                                                           Foreground="#FFAAAAAA"
                                                           FontSize="9"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{Binding TextBrush}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Details}"
                                                           Foreground="#FFAAAAAA"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding SubObjectives}"
                                                      Margin="25,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2,0,2"
                                                               LastChildFill="True">
                                                        <TextBlock Text="{Binding Marker}"
                                                                   Foreground="{Binding MarkerBrush}"
                                                                   FontSize="{Binding FontSize}"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{Binding TextBrush}"
                                                                   FontSize="{Binding FontSize}"
                                                                   TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Client log status -->
            <TextBlock x:Name="ClientLogStatus"
                       Grid.Row="3"
                       Text="Waiting for Client.txt..."
                       Foreground="#FFAAAAAA"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8"/>

            <!-- Manual navigation -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Previous"
                        Grid.Column="0"
                        Height="34"
                        Margin="0,0,5,0"
                        Background="#FF292929"
                        Foreground="White"
                        BorderBrush="#FF555555"
                        FontWeight="Bold"
                        Click="PreviousStepButton_Click"
                        Cursor="Hand"/>

                <Button Content="Next →"
                        Grid.Column="1"
                        Height="34"
                        Margin="5,0,0,0"
                        Background="#FF3A3524"
                        Foreground="#FFFFCC00"
                        BorderBrush="#FF665522"
                        FontWeight="Bold"
                        Click="NextStepButton_Click"
                        Cursor="Hand"/>

                <!-- Resize handle occupies its own space beside the navigation buttons. -->
                <Thumb x:Name="ResizeThumb"
                       Grid.Column="2"
                       Width="32"
                       Height="34"
                       Cursor="SizeNWSE"
                       Background="Transparent"
                       DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent">
                                <TextBlock Text="◢"
                                           Foreground="#FFAAAAAA"
                                           FontSize="20"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,2,2"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

        </Grid>
    </Border>
</Window>
